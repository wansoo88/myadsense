# 시크릿 — 절대 커밋 금지
.env
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 런타임 상태·생성물 (주석은 패턴과 같은 줄에 두지 말 것 — gitignore 미지원)
engine/store/*.db
engine/store/killswitch_state.json
engine/store/signals.json
# 리포트 산출물 (루트 한정 — 앞 / 로 앵커, engine/content 같은 하위 동명 디렉토리 보호)
/reports/
# 드라이런 미리보기·발행 큐
/dist/
# 생성된 발행 콘텐츠(SSG 빌드 산출물)
/content/

# 로그·임시
*.log
.DS_Store
Thumbs.db
engine/store/published.json
engine/store/indexnow_state.json

# 런타임 상태(서버·로컬이 각자 씀 — 추적하면 서버 pull 이 'untracked would be overwritten' 로 영구 실패)
engine/store/devto_state.json
engine/store/generation_alert_state.json
engine/store/last_publish_date.txt
